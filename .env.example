# SECRET MANAGEMENT
# Never put real credentials in this file or commit them to Git.
# Prefer runtime injection from 1Password, Vault, or your deployment platform.
# A local .env file is a development-only fallback and is ignored by Git.
# 1Password example: op run --env-file="./.env.op" -- npm run chat
# Full guidance: docs/secret-management.md

# BYO AI credentials are used only by the local chatbot. Remediation is deterministic.
CHECKMATE_CHAT_HOST=127.0.0.1
CHECKMATE_CHAT_PORT=4320
CHECKMATE_CHAT_AUTH0_ENABLED=true
CHECKMATE_CHAT_REMEDIATION_URL=http://127.0.0.1:4317
CHECKMATE_REPORTS_DIR=./reports
# Required write allowlist. It must equal AUTH0CHECKMATE_DEV_DOMAIN.
CHECKMATE_CHAT_DEV_WRITE_DOMAIN=

# Supported values: openai, anthropic, google.
# Only the API key for AI_PROVIDER is required. API usage is billed by that provider.
# Selects which provider's API key is used: openai | anthropic | google
AI_PROVIDER=openai

OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_TIMEOUT_MS=180000
OPENAI_API_KEY=

#ANTHROPIC_MODEL=claude-sonnet-4-6
#AI_REASONING_EFFORT=medium
#ANTHROPIC_API_KEY=

#GEMINI_MODEL=gemini-3.6-flash
#AI_REASONING_EFFORT=medium
#GEMINI_API_KEY=


# Use a separate, read-only Auth0 client for production assessment. Use canonical domain name.
AUTH0CHECKMATE_PROD_DOMAIN=
AUTH0CHECKMATE_PROD_CLIENT_ID=
AUTH0CHECKMATE_PROD_CLIENT_SECRET=

# Use a separate dev client. Grant only the write scopes required for execution. Use canonical domain name.
AUTH0CHECKMATE_DEV_DOMAIN=
AUTH0CHECKMATE_DEV_CLIENT_ID=
AUTH0CHECKMATE_DEV_CLIENT_SECRET=

AUTH0CHECKMATE_FILE_PATH=./reports
AUTH0CHECKMATE_TIMEOUT_MS=300000
